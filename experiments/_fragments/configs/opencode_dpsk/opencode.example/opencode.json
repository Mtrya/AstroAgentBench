{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "dpsk"
  ],
  "model": "dpsk/deepseek-v4-pro",
  "small_model": "dpsk/deepseek-v4-flash",
  "permission": "allow",
  "provider": {
    "dpsk": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "dpsk",
      "options": {
        "baseURL": "replace_with_dpsk_base_url",
        "apiKey": "replace_with_dpsk_api_key"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "interleaved": {
            "field": "reasoning_content"
          },
          "options": {
            "reasoning_effort": "max"
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  }
}
