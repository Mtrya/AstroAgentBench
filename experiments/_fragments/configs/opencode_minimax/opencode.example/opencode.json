{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "minimax"
  ],
  "model": "minimax/MiniMax-M2.7",
  "small_model": "minimax/MiniMax-M2.7",
  "permission": "allow",
  "provider": {
    "minimax": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiniMax",
      "options": {
        "baseURL": "replace_with_minimax_base_url",
        "apiKey": "replace_with_minimax_api_key"
      },
      "models": {
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7"
        }
      }
    }
  }
}
